# Application
APP_NAME=OneMate
APP_ENV=production
APP_KEY=base64:
APP_DEBUG=false
APP_URL=https://onemate.letunoff.ru
FRONTEND_URL=https://onemate.letunoff.ru

# Authentication
REGISTER_INVITE_CODE=

SANCTUM_STATEFUL_DOMAINS=onemate.letunoff.ru

# Database
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=onemate
DB_USERNAME=
DB_PASSWORD=

# Session
SESSION_DRIVER=database
SESSION_DOMAIN=onemate.letunoff.ru
SESSION_SECURE_COOKIE=true

# Cache & Queue
QUEUE_CONNECTION=database

# Filesystem
FILESYSTEM_DISK=local

# Cloud Storage
CLOUD_DISK=local
CLOUD_STORAGE_LIMIT_MB=500
CLOUD_FILE_MAX_SIZE_MB=250
CLOUD_TEXT_MAX_LENGTH=10000

# Network
CHECK_PROXY_HOST=
CHECK_PROXY_PORT=1080
CHECK_PROXY_USERNAME=
CHECK_PROXY_PASSWORD=
IPINFO_TOKEN=

# Mail
MAIL_MAILER=resend
MAIL_FROM_ADDRESS=noreply@letunoff.ru
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=

# Frontend build
VITE_OPENWEATHER_API_KEY=
VITE_MYMEMORY_API_KEY=