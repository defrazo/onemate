# Application
APP_NAME=OneMate
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://onemate.letunoff.ru
FRONTEND_URL=https://onemate.letunoff.ru

# Authentication
REGISTER_INVITE_CODE=
SANCTUM_STATEFUL_DOMAINS=onemate.letunoff.ru

# Integrations
TOOLBOX_OAUTH_CLIENT_ID=
TOOLBOX_API_URL=https://toolbox.letunoff.ru
TOOLBOX_INTERNAL_TOKEN=
TOOLBOX_TIMEOUT=5
TOOLBOX_DISCONNECT_TIMEOUT=10

# Database
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=onemate
DB_USERNAME=
DB_PASSWORD=

# Session
SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_EXPIRE_ON_CLOSE=false
SESSION_DOMAIN=onemate.letunoff.ru
SESSION_SECURE_COOKIE=true

# Cache & Queue
CACHE_STORE=database
QUEUE_CONNECTION=database

# Filesystem
FILESYSTEM_DISK=local

# Cloud Storage
CLOUD_DISK=s3
CLOUD_STORAGE_LIMIT_MB=1024
CLOUD_FILE_MAX_SIZE_MB=1024
CLOUD_TEXT_MAX_LENGTH=10000

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=onemate-prod
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

# Network
CHECK_PROXY_HOST=
CHECK_PROXY_PORT=1080
CHECK_PROXY_USERNAME=
CHECK_PROXY_PASSWORD=
IPINFO_TOKEN=

# Mail
MAIL_MAILER=resend
MAIL_FROM_ADDRESS=noreply@letunoff.ru
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=

# Frontend build
VITE_OPENWEATHER_API_KEY=
VITE_MYMEMORY_API_KEY=