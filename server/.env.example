# Application
APP_NAME=OneMate
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Localization
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Authentication
REGISTER_INVITE_CODE=
BCRYPT_ROUNDS=12

SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:8000,127.0.0.1:3000,127.0.0.1:8000

TOOLBOX_OAUTH_CLIENT_ID=
TOOLBOX_API_URL=http://localhost:8001
TOOLBOX_INTERNAL_TOKEN=
TOOLBOX_TIMEOUT=20
TOOLBOX_DISCONNECT_TIMEOUT=20

# Database
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=onemate
DB_USERNAME=
DB_PASSWORD=

# Session
SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_COOKIE=onemate_session
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Cache & Queue
CACHE_STORE=file
QUEUE_CONNECTION=database

# Filesystem
FILESYSTEM_DISK=local

# Cloud Storage
CLOUD_DISK=local
CLOUD_STORAGE_LIMIT_MB=500
CLOUD_FILE_MAX_SIZE_MB=250
CLOUD_TEXT_MAX_LENGTH=10000

# Network
CHECK_PROXY_HOST=
CHECK_PROXY_PORT=1080
CHECK_PROXY_USERNAME=
CHECK_PROXY_PASSWORD=
IPINFO_TOKEN=

# Mail
MAIL_MAILER=resend
MAIL_FROM_ADDRESS=noreply@letunoff.ru
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug