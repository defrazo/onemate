{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"paths": {
			"@/*": ["./src/*"]
		},
		"noEmit": true,
		"jsx": "react-jsx",
		"strict": true,
		"ignoreDeprecations": "6.0"
	},
	"include": ["src", "env.d.ts", "global.d.ts"],
	"exclude": ["node_modules"]
}
